{
  "version": 2,
  "builds": [
    {
      "src": "api/chat.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    {
      "source": "/api/chat",
      "destination": "api/chat.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}
